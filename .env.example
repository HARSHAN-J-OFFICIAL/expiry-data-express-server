# Server Port (Render sets PORT automatically)
PORT=5001

# Node Environment ('production' or 'development')
NODE_ENV=production

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas -> Database -> Connect -> Drivers
# Example: mongodb+srv://myUser:myPassword@cluster0.mongodb.net/expiry_db?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/expiry_db?retryWrites=true&w=majority

# Secret key for JWT Token signing (Use a strong random string in production)
JWT_SECRET=your_production_super_secret_jwt_key_here

# Deployed Frontend Client URL on Netlify (or comma-separated allowed CORS origins)
# Example: https://my-expiry-manager.netlify.app
CLIENT_URL=https://my-expiry-manager.netlify.app

# Deployed Backend Server URL on Render
# Example: https://expiry-date-express-server.onrender.com
SERVER_URL=https://expiry-date-express-server.onrender.com
